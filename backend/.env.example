# ============================================================
# APEX Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Django Core ---
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=apex.hadescoretech.com,www.apex.hadescoretech.com,YOUR_VPS_IP

# --- MongoDB ---
# Option A: MongoDB Atlas (Recommended)
MONGO_URI=mongodb+srv://hadescoreapextechnologies_db_user:Hadescore.com@cluster0.lkfkjsj.mongodb.net/
# Option B: Local MongoDB on VPS
# MONGO_URI=mongodb://localhost:27017

MONGO_DB_NAME=hadescore_db

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://apex.hadescoretech.com,https://www.apex.hadescoretech.com

# --- Email (Gmail SMTP) ---
EMAIL_HOST_USER=[EMAIL_ADDRESS]
EMAIL_HOST_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=[EMAIL_ADDRESS]

# --- Media Files ---
# Leave blank to use the default (backend/media/)
MEDIA_ROOT=

# --- JWT ---
# Optional overrides — defaults are 7 days access, 30 days refresh
# ACCESS_TOKEN_LIFETIME_DAYS=7
# REFRESH_TOKEN_LIFETIME_DAYS=30
